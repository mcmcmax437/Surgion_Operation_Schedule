# Keep this file on the VPS (not in git). Used by the Node API.

# Legacy shared department password (optional if ADMIN_EMAIL is set)
ACCESS_PASSWORD=

# Bootstrap admin account (created on API start if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Адміністратор

# Doctor self-registration (default true)
REGISTRATION_ENABLED=true

# Google Identity Services (optional). Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

PORT=3001
SESSION_DAYS=365

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=surgion_schedule

# Comma-separated IPs that can open admin tabs even without admin role (legacy)
LOGS_ALLOWED_IPS=212.75.114.136

# Past-dated operations go to archive, then auto-delete (with media) after N days
ARCHIVE_RETENTION_DAYS=7
ARCHIVE_TZ=Europe/Kyiv
ARCHIVE_JOB_MS=3600000
